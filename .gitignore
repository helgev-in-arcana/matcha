# Used for testing
matcha/src/main.rs
matcha/src/assets/

# AI
.agent/
.agents/
.claude/

# Memos
*.md

# Old implementation for reference when refactoring
**/*.old

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
# Trunk build output
matcha-web/dist/

# The font the web build embeds. Fetched by matcha-web/build.rs and
# cached here; ~9.6 MB of binary that does not belong in history. Its licence
# stays tracked, since built artifacts redistribute the font.
matcha-web/src/assets/NotoSansJP-VF.ttf
